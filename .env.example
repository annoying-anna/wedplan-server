# ---------------------------------------------------------------------------
# WedPlan Server (Express + MongoDB) — copy this file to `.env` for local dev
# Never commit real credentials. `.env*` files are git-ignored except this example.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Public URL of the deployed frontend (used for Stripe success/cancel redirects
# and CORS). In production use e.g. https://client-rho-five-11.vercel.app
CLIENT_URL=http://localhost:3000

# MongoDB Atlas or local connection string
MONGODB_URI=mongodb://127.0.0.1:27017/wedplan

# JWT signing secret (required in production)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Stripe Checkout (test mode is fine for the assignment)
# Leave blank to use the explicit demo checkout (ALLOW_MOCK_PAYMENTS).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Demo-only fallback when Stripe keys are absent. Set to "true" on a demo
# deployment so evaluators can walk through the upgrade screen without a charge.
# Real Stripe keys always take priority over this flag.
ALLOW_MOCK_PAYMENTS=true

# ---------------------------------------------------------------------------
# ImgBB (optional server-side uploads; the client uses NEXT_PUBLIC_IMGBB_API_KEY)
# ---------------------------------------------------------------------------
IMGBB_API_KEY=your_imgbb_api_key
